{
  "name": "career-wiki-runtime",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "wiki-engine",
    "resume-generator"
  ],
  "scripts": {
    "test:wiki-engine": "npm test --workspace career-wiki-wiki-engine",
